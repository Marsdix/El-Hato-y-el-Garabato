# Variables de entorno
# Copiar este archivo a .env y rellenar valores reales.
# Todas las variables DEBEN empezar por VITE_ para que Vite las incluya.

# URL del sitio en producción (sin barra final)
VITE_SITE_URL=https://www.tudominio.com

# ID de Formspree para el formulario de contacto (https://formspree.io)
# VITE_FORMSPREE_ID=xxxxxxxx

# Sanity CMS
VITE_SANITY_PROJECT_ID=rw1g8gn6
VITE_SANITY_DATASET=production
# VITE_SANITY_TOKEN=   # solo necesario si el dataset es privado
