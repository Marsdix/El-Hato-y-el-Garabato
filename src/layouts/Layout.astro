---
import '../App.css'
import { ClientRouter } from 'astro:transitions'
import AstroNavbarWrapper from '../components/layout/AstroNavbarWrapper.jsx'
import AstroFooterWrapper from '../components/layout/AstroFooterWrapper.jsx'
import AstroGlobalWrapper from '../components/layout/AstroGlobalWrapper.jsx'

const {
  title = 'El Hato y el Garabato — Bodega Arribes del Duero',
  description = 'Vinos artesanales de variedades ancestrales. 8 hectáreas de viñas centenarias en el Parque Natural Arribes del Duero, Zamora.',
} = Astro.props

// Ensure trailing slash so ${base}asset works for both '' and '/path' bases
const base = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/')
---

<!DOCTYPE html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      (function(){
        var t=localStorage.getItem('hato-theme');
        if(t) document.documentElement.setAttribute('data-theme',t);
        var l=localStorage.getItem('hato-lang');
        if(l) document.documentElement.lang=l;
      })()
    </script>
    <link rel="icon" type="image/png" href={`${base}favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}favicon.png`} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#c8a255" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://elhatoyelgarabato.com/" />
    <meta property="og:image" content="https://elhatoyelgarabato.com/og-cover.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://elhatoyelgarabato.com/og-cover.jpg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Cinzel:wght@400;600&family=Jost:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido</a>
    <AstroGlobalWrapper client:only="react" transition:persist />
    <AstroNavbarWrapper client:only="react" />
    <main id="main-content">
      <slot />
    </main>
    <AstroFooterWrapper client:only="react" />
  </body>
</html>
